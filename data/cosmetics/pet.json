{
  // Правила питомца. feedPrice — цена порции в монетках.
  // levels — сколько порций всего нужно для каждого уровня, начиная с первого (0); scales — увеличение картинки на этих уровнях.
  // sleepMinutes — питомец засыпает, если человек столько минут ничего не делает. happySeconds и eatSeconds — сколько длится радость и еда.
  // fps — скорость анимации, если у вида питомца своей нет.
  "feedPrice": 25,
  "levels": [0, 3, 8, 15, 25],
  "scales": [2, 2, 3, 3, 4],
  "sleepMinutes": 3,
  "happySeconds": 4,
  "eatSeconds": 3,
  "fps": 4
}
