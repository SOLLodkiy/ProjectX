    "quest": { "file": "ui/quest.wav", "volume": 0.8 },
    "level": { "file": "ui/level.wav", "volume": 0.9 },
    "achievement": { "file": "ui/achievement.wav", "volume": 0.8 },
    "chest": { "file": "ui/chest.wav", "volume": 0.8 },
    "event": { "file": "ui/event.wav", "volume": 0.7 },
    "warning": { "file": "ui/warning.wav", "volume": 0.7 },
    "survived": { "file": "ui/survived.wav", "volume": 0.7 },
    "feed": { "file": "ui/feed.wav", "volume": 0.7 },
    "pet": { "file": "ui/pet.wav", "volume": 0.5 }
