      "match": [ { "company": "Google*", "product": "Google Chrome*" } ] },
    { "id": "edge", "name": "Microsoft Edge", "extensionsPage": "edge://extensions",
      "match": [ { "company": "Microsoft*", "product": "Microsoft Edge*" } ] },
    { "id": "yandex", "name": "Яндекс Браузер", "extensionsPage": "browser://extensions",
      "match": [ { "company": "YANDEX*", "product": "Yandex" } ] },
    { "id": "firefox", "name": "Firefox", "extensionsPage": "about:addons",
      "match": [ { "company": "Mozilla*", "product": "Firefox*" } ] }
  ],

  // Слова в заголовке страницы управления расширениями. Пока она открыта, окно браузера не сворачивается.
