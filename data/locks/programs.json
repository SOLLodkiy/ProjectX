{
  // Цены программ. Запись срабатывает, если совпали все поля хотя бы одного условия из match.
  // Поля: company, product, original, description, package, path. Символ * заменяет любой текст.
  // Имени файла здесь нет намеренно: переименование не должно менять цену или открывать программу.
  "defaultPrice": 300,

  // Слова в описании файла, по которым опознаётся установщик.
  "installerWords": [ "setup", "install", "uninstall", "установ", "удален", "мастер настройки" ],

  "programs": [
    { "id": "notepad", "name": "Блокнот", "price": 50, "match": [
      { "company": "Microsoft*", "original": "notepad.exe" },
      { "package": "Microsoft.WindowsNotepad" } ] },
    { "id": "calculator", "name": "Калькулятор", "price": 50, "match": [
      { "company": "Microsoft*", "original": "calc.exe" },
      { "package": "Microsoft.WindowsCalculator" } ] },
    { "id": "paint", "name": "Paint", "price": 75, "match": [
      { "company": "Microsoft*", "original": "mspaint.exe" },
      { "package": "Microsoft.Paint" } ] },
