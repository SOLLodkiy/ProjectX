    { "id": "spotify", "name": "Spotify", "price": 900, "match": [ { "company": "Spotify*" } ] },
    { "id": "yandex-music", "name": "Яндекс Музыка", "price": 800, "match": [ { "product": "Яндекс Музыка" }, { "product": "Yandex Music" } ] },
    { "id": "vlc", "name": "VLC", "price": 700, "match": [ { "product": "VLC media player" } ] },
    { "id": "obs", "name": "OBS Studio", "price": 1000, "match": [ { "product": "OBS Studio" } ] },
    { "id": "photoshop", "name": "Photoshop", "price": 1500, "match": [ { "company": "Adobe*", "product": "*Photoshop*" } ] },
    { "id": "figma", "name": "Figma", "price": 1200, "match": [ { "company": "Figma*" } ] },
    { "id": "blender", "name": "Blender", "price": 1200, "match": [ { "product": "Blender" } ] },

    { "id": "steam", "name": "Steam", "price": 3000, "match": [ { "company": "Valve*", "product": "Steam*" } ] },
    { "id": "epic-launcher", "name": "Epic Games Launcher", "price": 2500, "match": [ { "company": "Epic Games*", "product": "*Launcher*" } ] },
