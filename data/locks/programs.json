    { "id": "norton", "match": [ { "company": "Norton*" }, { "company": "Symantec*" }, { "company": "McAfee*" } ] },
    { "id": "malwarebytes", "match": [ { "company": "Malwarebytes*" } ] },

    { "id": "nvidia", "match": [ { "company": "NVIDIA*" } ] },
    { "id": "amd", "match": [ { "company": "Advanced Micro Devices*" }, { "company": "AMD*" } ] },
