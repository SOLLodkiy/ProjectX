    { "id": "vscode", "name": "VS Code", "price": 250, "match": [ { "company": "Microsoft*", "product": "Visual Studio Code*" } ] },
    { "id": "thunderbird", "name": "Thunderbird", "price": 150, "match": [ { "product": "Thunderbird" } ] },
    { "id": "7zip", "name": "7-Zip", "price": 100, "match": [ { "product": "7-Zip" } ] },
    { "id": "winrar", "name": "WinRAR", "price": 100, "match": [ { "product": "WinRAR*" } ] },
    { "id": "acrobat", "name": "Adobe Acrobat", "price": 200, "match": [ { "company": "Adobe*", "product": "*Acrobat*" } ] },

    { "id": "telegram", "name": "Telegram", "price": 500, "match": [ { "product": "Telegram Desktop" } ] },
    { "id": "discord", "name": "Discord", "price": 500, "match": [ { "company": "Discord*" } ] },
    { "id": "whatsapp", "name": "WhatsApp", "price": 500, "match": [
      { "package": "5319275A.WhatsAppDesktop" },
      { "company": "WhatsApp*" } ] },
    { "id": "zoom", "name": "Zoom", "price": 400, "match": [ { "company": "Zoom*" } ] },
