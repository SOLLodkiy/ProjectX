      { "package": "Microsoft.Windows.Photos" } ] },

    { "id": "word", "name": "Word", "price": 200, "match": [ { "company": "Microsoft*", "original": "WinWord.exe" } ] },
    { "id": "excel", "name": "Excel", "price": 200, "match": [ { "company": "Microsoft*", "original": "Excel.exe" } ] },
    { "id": "powerpoint", "name": "PowerPoint", "price": 200, "match": [ { "company": "Microsoft*", "original": "PowerPnt.exe" } ] },
