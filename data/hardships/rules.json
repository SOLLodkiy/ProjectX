{
  // Планировщик усложнений (идея 009). Интервал и разброс — в минутах, предупреждение — в секундах.
  "intervalMinutes": 20,
  "spreadMinutes": 5,
  "warningSeconds": 10,
  // На сколько откладывается усложнение, если сейчас нельзя мешать (игра, UAC, «Не беспокоить», созвон).
  "postponeMinutes": 5,
  // Первое усложнение после запуска программы — не раньше этого.
  "firstDelayMinutes": 3,
  // Длительность в секундах и бонус за пережитое усложнение.
  "levels": {
    "Easy": { "min": 300, "max": 300, "bonus": 15 },
    "Medium": { "min": 120, "max": 180, "bonus": 25 },
    "Hard": { "min": 45, "max": 60, "bonus": 40 }
  },
  // Множитель всего дохода, частота относительно интервала и веса уровней «лёгкое, среднее, сложное».
  "modes": {
    "Off": { "multiplier": 0.5, "frequency": 0, "weights": [0, 0, 0] },
    "Soft": { "multiplier": 0.75, "frequency": 1, "weights": [1, 0, 0] },
    "Normal": { "multiplier": 1, "frequency": 1, "weights": [3, 2, 1] },
    "Hardcore": { "multiplier": 1.5, "frequency": 1.6, "weights": [1, 2, 3] }
  }
}
