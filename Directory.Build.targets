<Project>
  <!-- Раскладывает собранный модуль в папку modules рядом с приложением. -->
  <Target Name="DeployModuleToApp"
          AfterTargets="Build"
          Condition="'$(IsModuleProject)' == 'true'">
    <PropertyGroup>
      <ModuleDeployDir>$(RepoRoot)src\ADHDWindows.App\bin\$(Configuration)\net10.0-windows\modules\$(MSBuildProjectName)\</ModuleDeployDir>
    </PropertyGroup>
    <ItemGroup>
      <ModuleOutputFile Include="$(OutDir)**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(ModuleOutputFile)"
          DestinationFiles="@(ModuleOutputFile->'$(ModuleDeployDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- Сторож лежит в своей папке: у него свои файлы запуска, которые не должны смешиваться с файлами приложения. -->
  <Target Name="DeployWatchdogToApp"
          AfterTargets="Build"
          Condition="'$(MSBuildProjectName)' == 'ADHDWindows.Watchdog'">
    <PropertyGroup>
      <WatchdogDeployDir>$(RepoRoot)src\ADHDWindows.App\bin\$(Configuration)\net10.0-windows\watchdog\</WatchdogDeployDir>
    </PropertyGroup>
    <ItemGroup>
      <WatchdogOutputFile Include="$(OutDir)**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(WatchdogOutputFile)"
          DestinationFiles="@(WatchdogOutputFile->'$(WatchdogDeployDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
