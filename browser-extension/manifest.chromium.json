{
  "manifest_version": 3,
  "name": "ADHDWindows",
  "version": "0.8.0",
  "description": "Сайты открываются за монетки ADHDWindows. Работает вместе с программой.",
  "key": "",
  "minimum_chrome_version": "120",
  "permissions": ["nativeMessaging", "declarativeNetRequestWithHostAccess", "tabs", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "incognito": "spanning",
  "web_accessible_resources": [ { "resources": ["blocked.html"], "matches": ["<all_urls>"] } ],
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
