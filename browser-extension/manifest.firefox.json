{
  "manifest_version": 3,
  "name": "ADHDWindows",
  "version": "0.9.0",
  "description": "Сайты открываются за монетки ADHDWindows, а видео и музыка приносят монетки. Работает вместе с программой.",
  "browser_specific_settings": {
    "gecko": { "id": "adhdwindows@adhdwindows.app", "strict_min_version": "128.0" }
  },
  "permissions": ["nativeMessaging", "declarativeNetRequestWithHostAccess", "tabs", "alarms", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": { "scripts": ["background.js"], "type": "module" },
  "incognito": "spanning",
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["media-hook.js"], "all_frames": true, "match_about_blank": true, "run_at": "document_start", "world": "MAIN" },
    { "matches": ["<all_urls>"], "js": ["media.js"], "all_frames": true, "match_about_blank": true, "run_at": "document_start" }
  ],
  "web_accessible_resources": [ { "resources": ["blocked.html"], "matches": ["<all_urls>"] } ],
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
