<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Браузер запускает мост без окна консоли и общается с ним через стандартные потоки. -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>ADHDWindows.BrowserHost</AssemblyName>
    <!-- Мост живёт всё время, пока открыт браузер, и должен занимать как можно меньше памяти. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ADHDWindows.Core\ADHDWindows.Core.csproj" />
    <ProjectReference Include="..\ADHDWindows.Platform\ADHDWindows.Platform.csproj" />
  </ItemGroup>

</Project>
