<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:d="clr-namespace:ADHDWindows.App.Design">

    <!-- Шаги отступов дизайн-системы, в пикселях арта. -->
    <Thickness x:Key="Space.S">2</Thickness>
    <Thickness x:Key="Space.M">4</Thickness>
    <Thickness x:Key="Space.L">6</Thickness>

    <!-- Строковое содержимое любых элементов рисуется пиксельным шрифтом. -->
    <DataTemplate DataType="{x:Type sys:String}">
        <d:PixelText Text="{Binding}" />
    </DataTemplate>

    <Style x:Key="Text.Title" TargetType="d:PixelText">
        <Setter Property="FontRole" Value="Title" />
        <Setter Property="Shadow" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.gold}" />
    </Style>

    <Style x:Key="Text.Dim" TargetType="d:PixelText">
        <Setter Property="Foreground" Value="{DynamicResource Brush.mist}" />
    </Style>

    <Style x:Key="Panel" TargetType="d:PixelFrame">
        <Setter Property="Sprite" Value="panel" />
        <Setter Property="Padding" Value="{StaticResource Space.L}" />
    </Style>

    <Style x:Key="Inset" TargetType="d:PixelFrame">
        <Setter Property="Sprite" Value="inset" />
        <Setter Property="Padding" Value="{StaticResource Space.L}" />
    </Style>

    <Style TargetType="d:PixelButton">
        <Setter Property="Focusable" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.text}" />
        <Setter Property="Padding" Value="8,4,8,5" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="d:PixelButton">
                    <d:PixelFrame Sprite="{Binding FrameSprite, RelativeSource={RelativeSource TemplatedParent}}"
                                  Padding="{TemplateBinding Padding}">
                        <ContentPresenter x:Name="Content"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </d:PixelFrame>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Content" Property="Margin" Value="0,1,0,-1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Kind" Value="Primary">
                <Setter Property="Foreground" Value="{DynamicResource Brush.ink}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Brush.line}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Button.Icon" TargetType="d:PixelButton" BasedOn="{StaticResource {x:Type d:PixelButton}}">
        <Setter Property="Padding" Value="2" />
    </Style>

    <Style TargetType="d:PixelWindow">
        <Setter Property="WindowStyle" Value="None" />
        <Setter Property="AllowsTransparency" Value="True" />
        <Setter Property="ResizeMode" Value="NoResize" />
        <Setter Property="SizeToContent" Value="WidthAndHeight" />
        <Setter Property="Background" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="d:PixelWindow">
                    <d:PixelRoot UiScale="{TemplateBinding UiScale}">
                        <d:PixelFrame Sprite="window" Padding="2">
                            <DockPanel>
                                <d:PixelFrame x:Name="PART_TitleBar" DockPanel.Dock="Top"
                                              Sprite="title_bar" Padding="4,3">
                                    <DockPanel>
                                        <d:PixelButton x:Name="PART_Close" DockPanel.Dock="Right" Kind="Danger"
                                                       Style="{StaticResource Button.Icon}" Focusable="False">
                                            <d:PixelImage Sprite="close" />
                                        </d:PixelButton>
                                        <d:PixelImage Sprite="{TemplateBinding IconSprite}"
                                                      VerticalAlignment="Center" Margin="0,0,4,0" />
                                        <d:PixelText Text="{TemplateBinding Title}" FontRole="Title" Shadow="True"
                                                     VerticalAlignment="Center" />
                                    </DockPanel>
                                </d:PixelFrame>
                                <ContentPresenter Margin="{StaticResource Space.L}" />
                            </DockPanel>
                        </d:PixelFrame>
                    </d:PixelRoot>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabControl">
        <Setter Property="Foreground" Value="{DynamicResource Brush.text}" />
        <Setter Property="Padding" Value="{StaticResource Space.L}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid KeyboardNavigation.TabNavigation="Local">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <d:PixelFrame Grid.Row="1" Sprite="panel" Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                        </d:PixelFrame>
                        <TabPanel Grid.Row="0" Panel.ZIndex="1" Margin="3,0,3,-1" IsItemsHost="True" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource Brush.text}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <!-- Цвет задаётся на рамке: цвет самой вкладки унаследовало бы её содержимое. -->
                    <d:PixelFrame x:Name="Frame" Sprite="tab" Padding="7,3,7,3" Margin="0,0,1,0"
                                  TextElement.Foreground="{DynamicResource Brush.mist}">
                        <ContentPresenter ContentSource="Header" />
                    </d:PixelFrame>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="Sprite" Value="tab_hover" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Frame" Property="Sprite" Value="tab_active" />
                            <Setter TargetName="Frame" Property="TextElement.Foreground"
                                    Value="{DynamicResource Brush.gold}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ListBox">
        <Setter Property="Foreground" Value="{DynamicResource Brush.text}" />
        <Setter Property="Background" Value="{x:Null}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <d:PixelFrame Sprite="inset" Padding="3">
                        <ScrollViewer Focusable="False">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </d:PixelFrame>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.text}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <d:PixelFrame x:Name="Frame" Padding="4,3">
                        <ContentPresenter />
                    </d:PixelFrame>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="Sprite" Value="list_hover" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Frame" Property="Sprite" Value="list_selected" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Scroll.Page" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Scroll.Thumb" TargetType="Thumb">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <d:PixelFrame x:Name="Frame" Sprite="scroll_thumb" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="Sprite" Value="scroll_thumb_hover" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Frame" Property="Sprite" Value="scroll_thumb_hover" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="7" />
        <Setter Property="MinWidth" Value="7" />
        <Setter Property="Margin" Value="2,0,0,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Style="{StaticResource Scroll.Page}" Command="ScrollBar.PageUpCommand" />
                        </Track.DecreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb Style="{StaticResource Scroll.Thumb}" />
                        </Track.Thumb>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Style="{StaticResource Scroll.Page}" Command="ScrollBar.PageDownCommand" />
                        </Track.IncreaseRepeatButton>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
