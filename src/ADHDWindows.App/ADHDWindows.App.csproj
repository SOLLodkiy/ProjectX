<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>ADHDWindows</AssemblyName>
    <UseWPF>true</UseWPF>
    <!-- WinForms нужен только для значка в трее. -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>$(RepoRoot)assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WFO0003 относится к приложениям WinForms. Здесь интерфейс на WPF, и масштаб задаётся в манифесте. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <PublishSelfContained>true</PublishSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ADHDWindows.Core\ADHDWindows.Core.csproj" />
    <ProjectReference Include="..\ADHDWindows.Platform\ADHDWindows.Platform.csproj" />
    <!-- Сторож работает отдельным процессом, поэтому его сборка только раскладывается рядом. -->
    <ProjectReference Include="..\ADHDWindows.Watchdog\ADHDWindows.Watchdog.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false" />
    <!-- Мост браузера запускает сам браузер, приложению нужна только его сборка рядом. -->
    <ProjectReference Include="..\ADHDWindows.BrowserHost\ADHDWindows.BrowserHost.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false" />
    <!-- Только порядок сборки: приложение не знает о модулях, новый проект подхватывается по имени. -->
    <ProjectReference Include="..\ADHDWindows.Modules.*\*.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="$(RepoRoot)data\**\*"
             Link="data\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <!-- Исходники спрайтов в программу не входят: нужны только собранные ресурсы. -->
    <Content Include="$(RepoRoot)assets\**\*"
             Exclude="$(RepoRoot)assets\src\**\*"
             Link="assets\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Расширение браузера: общие файлы, свой манифест для Chromium и Firefox и пиксельные ресурсы для экрана покупки. -->
  <ItemGroup>
    <Content Include="$(RepoRoot)browser-extension\src\**\*"
             Link="browser-extension\chromium\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(RepoRoot)browser-extension\src\**\*"
             Link="browser-extension\firefox\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(RepoRoot)browser-extension\manifest.chromium.json"
             Link="browser-extension\chromium\manifest.json"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(RepoRoot)browser-extension\manifest.firefox.json"
             Link="browser-extension\firefox\manifest.json"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(RepoRoot)assets\fonts\*.json;$(RepoRoot)assets\sprites\*;$(RepoRoot)assets\palette.json;$(RepoRoot)data\texts\ru.json"
             Link="browser-extension\chromium\pixel\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(RepoRoot)assets\fonts\*.json;$(RepoRoot)assets\sprites\*;$(RepoRoot)assets\palette.json;$(RepoRoot)data\texts\ru.json"
             Link="browser-extension\firefox\pixel\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
