<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Версия Windows нужна, чтобы подключить модуль хронометража: он читает системные сессии мультимедиа. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ADHDWindows.Core\ADHDWindows.Core.csproj" />
    <ProjectReference Include="..\..\src\ADHDWindows.Platform\ADHDWindows.Platform.csproj" />
    <ProjectReference Include="..\..\src\ADHDWindows.App\ADHDWindows.App.csproj" />
    <ProjectReference Include="..\..\src\ADHDWindows.Modules.Clicks\ADHDWindows.Modules.Clicks.csproj" />
    <ProjectReference Include="..\..\src\ADHDWindows.Modules.Locks\ADHDWindows.Modules.Locks.csproj" />
    <ProjectReference Include="..\..\src\ADHDWindows.Modules.Time\ADHDWindows.Modules.Time.csproj" />
    <ProjectReference Include="..\..\src\ADHDWindows.Modules.Upgrades\ADHDWindows.Modules.Upgrades.csproj" />
    <ProjectReference Include="..\..\src\ADHDWindows.Modules.Stats\ADHDWindows.Modules.Stats.csproj" />
    <ProjectReference Include="..\..\src\ADHDWindows.Modules.Progress\ADHDWindows.Modules.Progress.csproj" />
    <ProjectReference Include="..\..\src\ADHDWindows.Modules.Quests\ADHDWindows.Modules.Quests.csproj" />
    <ProjectReference Include="..\..\src\ADHDWindows.Modules.Hardships\ADHDWindows.Modules.Hardships.csproj" />
    <ProjectReference Include="..\..\src\ADHDWindows.Modules.Hardships.Basic\ADHDWindows.Modules.Hardships.Basic.csproj" />
    <ProjectReference Include="..\..\src\ADHDWindows.Modules.Hardships.Cursor\ADHDWindows.Modules.Hardships.Cursor.csproj" />
    <ProjectReference Include="..\..\src\ADHDWindows.Modules.Hardships.Screen\ADHDWindows.Modules.Hardships.Screen.csproj" />
    <ProjectReference Include="..\..\src\ADHDWindows.Modules.Hardships.Physics\ADHDWindows.Modules.Hardships.Physics.csproj" />
    <ProjectReference Include="..\..\src\ADHDWindows.Modules.Hardships.Keyboard\ADHDWindows.Modules.Hardships.Keyboard.csproj" />
    <ProjectReference Include="..\..\src\ADHDWindows.Modules.Hardships.Sounds\ADHDWindows.Modules.Hardships.Sounds.csproj" />
    <!-- Отдельная программа: тесты запускают и замораживают её как процесс. -->
    <ProjectReference Include="..\ADHDWindows.TestApp\ADHDWindows.TestApp.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false" />
    <!-- Тестовый модуль загружается из файла, как в программе, поэтому сборка не подключается. -->
    <ProjectReference Include="..\..\src\ADHDWindows.Modules.Sample\ADHDWindows.Modules.Sample.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false" />
  </ItemGroup>

</Project>
