<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>
    <IsModuleProject Condition="$(MSBuildProjectName.StartsWith('ADHDWindows.Modules.'))">true</IsModuleProject>
  </PropertyGroup>

  <!-- Проекту модуля достаточно называться ADHDWindows.Modules.*: остальное подключается здесь. -->
  <PropertyGroup Condition="'$(IsModuleProject)' == 'true'">
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>
  <ItemGroup Condition="'$(IsModuleProject)' == 'true'">
    <ProjectReference Include="$(RepoRoot)src\ADHDWindows.Core\ADHDWindows.Core.csproj"
                      Private="false"
                      ExcludeAssets="runtime" />
  </ItemGroup>
</Project>
